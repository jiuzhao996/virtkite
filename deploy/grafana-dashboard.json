{
  "title": "vmops 宿主机与平台",
  "uid": "vmops-overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "运行中 VM",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(vmops_vm_running)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "宿主机 CPU %",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "vmops_host_cpu_percent",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "任务堆积",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "vmops_tasks_pending + vmops_tasks_running",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "宿主机 CPU / 内存",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "expr": "vmops_host_cpu_percent",
          "refId": "A",
          "legendFormat": "CPU %"
        },
        {
          "expr": "100 * vmops_host_mem_used_kib / vmops_host_mem_total_kib",
          "refId": "B",
          "legendFormat": "内存 %"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "存储池使用率 %",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "100 * (1 - vmops_pool_available_bytes / vmops_pool_capacity_bytes)",
          "refId": "A",
          "legendFormat": "{{pool}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "style": "light",
  "version": 1
}