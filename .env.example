# vmops（鸢航 VirtKite）环境变量模板
#
# 用法（在仓库根目录，与 docker-compose.yml 同级）：
#   cp .env.example .env
#   chmod 600 .env          # 只给属主读，切勿入库（.gitignore 已忽略 /.env）
# 然后按下面「必填」清单逐个生成并填入真实值，最后：
#   docker compose -f docker-compose.yml config >/dev/null   # 校验：缺变量会直接报错
#
# ⚠️ 本文件不含任何真实口令，禁止把填好值的 .env 提交进仓库。
# ⚠️ 存量部署迁移：仓库历史上出现过弱口令，一律视为已泄露，请全部轮换（见文末）。

# ============================================================================
# 一、必填项（缺失时 docker compose 直接拒绝启动，绝不静默回落到弱口令）
# ============================================================================

# 生成强随机口令的统一命令（每个变量都用独立随机值，不要复用）：
#   openssl rand -hex 24     # 48 位十六进制
#   openssl rand -base64 32  # 44 位 base64（含 +/=，若担心 YAML 转义优先用 -hex）
# 一键写入示例：
#   printf 'DB_PASSWORD=%s\n' "$(openssl rand -hex 24)" >> .env

# MySQL 业务账号 vmops 的口令。mysql 服务的 MYSQL_PASSWORD 与 app 服务的 DB_PASSWORD
# 共用这一个变量，两处天然一致。
DB_PASSWORD=

# MySQL root 口令（仅数据库初始化与健康检查使用）。
# 注意：MYSQL_PASSWORD 只在数据卷首次初始化时生效，改 .env 不会自动改库内口令，
# 存量库需另行 ALTER USER 改密（见文末迁移步骤）。
MYSQL_ROOT_PASSWORD=

# JWT 会话签名密钥，建议 32 字节以上随机值。
JWT_SECRET_KEY=

# 凭据加密主密钥：VM SSH 口令落库用的 AES-256-GCM 主密钥。
# 必须与 JWT_SECRET_KEY 完全不同——二者同源会让「轮换 JWT 密钥」连带废掉全部历史
# 凭据（现象是解密失败、凭据看起来像损坏）。留空会回落 JWT 密钥并打警告日志。
CREDENTIAL_MASTER_KEY=

# Grafana admin 口令。
GRAFANA_ADMIN_PASSWORD=

# ============================================================================
# 二、可选项（有默认值，按需覆盖）
# ============================================================================

# --- 数据库 ---
DB_HOST=127.0.0.1          # compose 形态由 docker-compose.yml 覆盖为 mysql
DB_PORT=3306
DB_USER=vmops
DB_NAME=vmops

# --- 服务 ---
SERVER_PORT=8080
SERVER_MODE=release        # release 为安全默认；本地开发由 start.sh 显式设为 debug
JWT_EXPIRE_MINUTES=1440

# 公网部署务必收窄到实际域名，不要留 *（release 模式下默认值为 *）
CORS_ORIGINS=

# --- 存储路径（部署到新机器必须改成该宿主机的可写目录，勿照抄示例路径）---
IMAGE_DIR=/var/lib/libvirt/images
SEED_DIR=

# --- 监控栈（compose 形态用服务名，宿主机直跑用 127.0.0.1）---
GRAFANA_URL=http://127.0.0.1:3000
PROMETHEUS_URL=http://127.0.0.1:9090
ALERTMANAGER_URL=http://127.0.0.1:9093

# Prometheus file_sd 服务发现目标文件；为空则不启用
FILE_SD_PATH=

# Loki 日志查询代理地址；为空则日志功能不可用
LOKI_URL=

# --- 公网暴露面令牌（平台经 nginx/frp 公网可达时必须启用）---
# /metrics 抓取令牌：Prometheus 侧 bearer_token 需与之一致，为空则 /metrics 公开
METRICS_TOKEN=
# Alertmanager webhook 令牌：需在 deploy/alertmanager.yml 的 webhook url 追加 ?token=<值>
ALERT_WEBHOOK_TOKEN=
# 生成：openssl rand -hex 32

# --- Grafana 管理员用户名（可选，默认 admin）---
GRAFANA_ADMIN_USER=admin

# ============================================================================
# 三、存量部署迁移（历史弱口令一律视为已泄露）
# ============================================================================
# 1) 生成新口令并写入 .env（上面「必填项」全部轮换，勿复用旧值）
# 2) 改库内口令（改 .env 不会自动改库，数据卷已初始化时尤其注意）：
#      ALTER USER 'vmops'@'%' IDENTIFIED BY '<新 DB_PASSWORD>';
#      ALTER USER 'root'@'%'  IDENTIFIED BY '<新 MYSQL_ROOT_PASSWORD>';
# 3) Grafana 需登录后改密，或删除 grafana-data 卷重建
# 4) 轮换 CREDENTIAL_MASTER_KEY 会让历史 SSH 凭据无法解密，需先备份再重新录入凭据
# 5) docker compose up -d 重启生效
